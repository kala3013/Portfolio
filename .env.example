# Environment Variables Configuration
# Copy this file to .env for local development with optional integrations.
# NEVER commit your actual .env file with secrets into version control!

# Optional: Custom domain configuration
VITE_SITE_URL="https://kalanidhi.dev"

# Optional: Formspree / EmailJS Contact Endpoint (if using external mail service)
# Example: https://formspree.io/f/your_form_id
VITE_CONTACT_ENDPOINT=""

# Optional: AI Provider Key for extended live agent inference
# By default, the portfolio uses a deterministic grounded client-side engine with 0 API keys required.
# If connecting an external LLM server (e.g. OpenAI / Google Gemini):
VITE_AI_API_ENDPOINT=""
VITE_AI_API_KEY=""

# Optional: GitHub Personal Access Token (Read-only, for high-rate-limit repo fetching)
VITE_GITHUB_TOKEN=""
